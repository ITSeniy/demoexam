<Window x:Class="ObuVApp.Windows.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО «Обувь» — Заказы" Height="650" Width="1000"
        WindowStartupLocation="CenterOwner"
        Icon="/Resources/Icon.ico"
        Background="#FFFFFF"
        FontFamily="Times New Roman">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#7FFF00" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Resources/picture.png" Height="40" Stretch="Uniform" Margin="0,0,12,0"/>
                <TextBlock Text="Заказы" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center" FontFamily="Times New Roman"/>
            </StackPanel>
        </Border>

        <!-- Таблица заказов -->
        <DataGrid Grid.Row="1" x:Name="DgOrders"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserDeleteRows="False"
                  CanUserAddRows="False"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F5FFF5"
                  FontFamily="Times New Roman"
                  FontSize="13"
                  Margin="8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding НомерЗаказа}" Width="50"/>
                <DataGridTextColumn Header="Дата заказа" Binding="{Binding ДатаЗаказа, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Дата доставки" Binding="{Binding ДатаДоставки, StringFormat=dd.MM.yyyy}" Width="110"/>
                <DataGridTextColumn Header="Пункт выдачи" Binding="{Binding АдресПунктаВыдачи}" Width="250"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding ФИОКлиента}" Width="200"/>
                <DataGridTextColumn Header="Код" Binding="{Binding КодДляПолучения}" Width="60"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding СтатусЗаказа}" Width="100"/>
                <DataGridTemplateColumn Header="Действия" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" x:Name="BtnPanel">
                                <Button Content="Изменить" Height="24" Padding="8,0"
                                        Margin="0,0,4,0" FontFamily="Times New Roman" FontSize="12"
                                        Background="#00FA9A" BorderThickness="0" Cursor="Hand"
                                        Tag="{Binding}" Click="BtnEdit_Click"
                                        Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"/>
                                <Button Content="Удалить" Height="24" Padding="8,0"
                                        FontFamily="Times New Roman" FontSize="12"
                                        Background="Salmon" BorderThickness="0" Cursor="Hand"
                                        Tag="{Binding}" Click="BtnDelete_Click"
                                        Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Нижняя панель -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TbCount" VerticalAlignment="Center"
                           FontFamily="Times New Roman"/>
                <Button x:Name="BtnAdd" Grid.Column="1" Content="+ Добавить заказ"
                        Height="34" Padding="16,0" FontFamily="Times New Roman" FontSize="13"
                        Background="#00FA9A" BorderThickness="0" Cursor="Hand"
                        Click="BtnAdd_Click" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>
</Window>
