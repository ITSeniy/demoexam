<Window x:Class="ObuVApp.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО «Обувь» — Вход" Height="420" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="/Resources/Icon.ico"
        Background="#FFFFFF"
        FontFamily="Times New Roman">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#7FFF00" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Resources/picture.png" Height="50" Stretch="Uniform" Margin="0,0,12,0"/>
                <TextBlock Text="ООО «Обувь»" FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center" FontFamily="Times New Roman"/>
            </StackPanel>
        </Border>

        <!-- Форма входа -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="60,0">
            <TextBlock Text="Авторизация" FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,24" FontFamily="Times New Roman"/>

            <TextBlock Text="Логин:" FontFamily="Times New Roman" Margin="0,0,0,4"/>
            <TextBox x:Name="TbLogin" Height="32" FontFamily="Times New Roman" FontSize="14"
                     Padding="6,4" BorderBrush="#7FFF00" BorderThickness="2"/>

            <TextBlock Text="Пароль:" FontFamily="Times New Roman" Margin="0,12,0,4"/>
            <PasswordBox x:Name="PbPassword" Height="32" FontFamily="Times New Roman" FontSize="14"
                         Padding="6,4" BorderBrush="#7FFF00" BorderThickness="2"/>

            <TextBlock x:Name="TbError" Foreground="Red" Margin="0,8,0,0"
                       FontFamily="Times New Roman" TextWrapping="Wrap"/>

            <Button Content="Войти" Height="36" Margin="0,16,0,0" FontSize="14"
                    FontFamily="Times New Roman" Background="#00FA9A" BorderThickness="0"
                    Cursor="Hand" Click="BtnLogin_Click"/>
        </StackPanel>

        <!-- Кнопка гостя -->
        <Button Grid.Row="2" Content="Войти как гость (без авторизации)"
                Height="38" Margin="60,8,60,20" FontFamily="Times New Roman" FontSize="13"
                Background="#7FFF00" BorderThickness="0" Cursor="Hand"
                Click="BtnGuest_Click"/>
    </Grid>
</Window>
